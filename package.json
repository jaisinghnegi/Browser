{
  "name": "on-device-privacy-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/generate-contract.mjs",
    "test": "vitest run",
    "pretest": "node scripts/generate-contract.mjs",
    "test:e2e": "playwright test",
    "build:e2e-isolated": "node -e \"process.env.BUILD_PORT='8172';process.env.BUILD_OUT_DIR='dist-e2e';process.env.BUILD_PREVIEW_PACE_MS='900';require('child_process').execSync('node scripts/build.mjs',{stdio:'inherit'})\"",
    "test:e2e:isolated": "node -e \"process.env.E2E_PORT='8172';process.env.E2E_EXT_DIR='dist-e2e';require('child_process').execSync('npx playwright test --grep-invert @vlm',{stdio:'inherit'})\"",
  "test:e2e:vlm": "node -e \"process.env.E2E_PORT='8172';process.env.E2E_EXT_DIR='dist-e2e';process.env.PLANNER_MODE='vlm';process.env.VLM_BASE_URL=process.env.VLM_BASE_URL||'http://127.0.0.1:8973';require('child_process').execSync('npx playwright test --grep @vlm',{stdio:'inherit'})\"",
    "test:launcher": "vitest run --config vitest.launcher.config.ts",
    "demo:up": "node scripts/dev.mjs up",
    "demo:status": "node scripts/dev.mjs status",
    "demo:down": "node scripts/dev.mjs down",
    "model:download": "node scripts/download-model.mjs",
    "phase2:fixtures": "node scripts/build-phase2-manifest.mjs && node scripts/generate-phase2-fixtures.mjs && node scripts/measure-phase2-fixtures.mjs && node scripts/freeze-phase2-split.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "26.5.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
