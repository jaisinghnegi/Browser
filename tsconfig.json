{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["chrome", "node"]
  },
  "include": ["extension/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
